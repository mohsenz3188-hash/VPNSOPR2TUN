# Generate: vpnsopr --generate-token
VPNSOPR_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
VPNSOPR_XRAY=/usr/local/bin/xray
# Operator-approved absolute executable paths only. JSON must stay on one line.
VPNSOPR_ADAPTER_BINARIES={"frpc":"/usr/local/bin/frpc","frps":"/usr/local/bin/frps","gost":"/usr/local/bin/gost","backhaul":"/usr/local/bin/backhaul"}
# Set only when the panel is accessible exclusively behind your trusted HTTPS proxy:
# VPNSOPR_PUBLIC_HTTPS=1
# Or use native panel HTTPS:
# VPNSOPR_PANEL_CERT=/etc/vpnsopr/tls/fullchain.pem
# VPNSOPR_PANEL_KEY=/etc/vpnsopr/tls/privkey.pem
